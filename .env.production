PORT=4000
FRONTEND_URL=https://app.faithfightersforamerica.com,https://admin.faithfightersforamerica.com
NODE_ENV=production

JWT_SECRET=replace_with_strong_production_jwt_secret

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/faithfighters?retryWrites=true&w=majority

# Cloudflare R2
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
AWS_REGION=auto
AWS_ACCESS_KEY_ID=replace_with_production_r2_access_key
AWS_SECRET_ACCESS_KEY=replace_with_production_r2_secret_key
S3_BUCKET_NAME=fffa
CLOUDFRONT_URL=https://replace_with_production_r2_public_url

# Stripe (Live Keys)
STRIPE_SECRET_KEY=sk_live_replace_with_production_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_production_webhook_secret
STRIPE_PRICE_FAITH_BUILDER=price_replace_with_live_price_id
STRIPE_PRICE_FAITH_HERO=price_replace_with_live_price_id
STRIPE_PRICE_FAITH_FIGHTER=price_replace_with_live_price_id
